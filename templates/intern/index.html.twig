{% extends 'base.html.twig' %}

{% block title %}Trombinoscope{% endblock %}

{% block body %}
    <div class="container my-4">

        <div class="row g-4">
            {% for intern in interns %}
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 text-center shadow-sm">
                        <div class="card-body">
                            <div class="intern-photo mx-auto mb-3">
                                {{ intern.firstName|first }}{{ intern.lastName|first }}
                            </div>
                            <h5 class="card-title mb-1">
                                {{ intern.firstName }} {{ intern.lastName }}
                            </h5>
                            <p class="text-muted small mb-3">N° {{ intern.afpaNumber }}</p>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_intern_crud_show', {id: intern.id}) }}"
                                   class="btn btn-sm btn-outline-secondary">Infos</a>
                            
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_intern_crud_edit', {id: intern.id}) }}"
                                       class="btn btn-sm btn-outline-primary">Modifier</a>
                                    <a href="{{ path('app_intern_crud_show', {id: intern.id}) }}"
                                       class="btn btn-sm btn-outline-danger">Supprimer</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Aucun stagiaire pour le moment.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
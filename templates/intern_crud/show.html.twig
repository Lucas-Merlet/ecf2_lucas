{% extends 'base.html.twig' %}

{% block title %}{{ intern.firstName }} {{ intern.lastName }}{% endblock %}

{% block body %}
    <div class="container my-4">

        {# --- Infos du stagiaire --- #}
        <div class="card mb-4">
            <div class="card-body">
                <h1 class="h3 mb-3 {{ intern.isFlagged ? 'text-danger fw-bold' : '' }}">
                    {{ intern.firstName }} {{ intern.lastName }}
                    {% if intern.isFlagged %}
                        <span title="Plus de 5 absences sans motif">⚠️</span>
                    {% endif %}
                </h1>
                <p class="mb-1"><strong>N° AFPA :</strong> {{ intern.afpaNumber }}</p>
                <p class="mb-0"><strong>Téléphone :</strong> {{ intern.phone }}</p>
            </div>
        </div>

        {# --- Liste des absences --- #}
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Absences ({{ intern.absences|length }})</span>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_absence_crud_new') }}" class="btn btn-sm btn-success">
                        + Ajouter une absence
                    </a>
                {% endif %}
            </div>

            <div class="card-body">
                {% if intern.absences is empty %}
                    <p class="text-muted mb-0">Aucune absence enregistrée.</p>
                {% else %}
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Motif</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for absence in intern.absences %}
                                <tr>
                                    <td>{{ absence.date|date('d/m/Y') }}</td>
                                    <td>{{ absence.reason.label }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        {# --- Actions --- #}
        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_intern_index') }}" class="btn btn-outline-secondary">Retour au trombinoscope</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_intern_crud_edit', {'id': intern.id}) }}" class="btn btn-outline-primary">Modifier</a>
            {% endif %}
        </div>

    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Absence{% endblock %}

{% block body %}
    <h1>Absence</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ absence.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ absence.date ? absence.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>ProofPath</th>
                <td>{{ absence.proofPath }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_absence_crud_index') }}">back to list</a>

    <a href="{{ path('app_absence_crud_edit', {'id': absence.id}) }}">edit</a>

    {{ include('absence_crud/_delete_form.html.twig') }}
{% endblock %}
